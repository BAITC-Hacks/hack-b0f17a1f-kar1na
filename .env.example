# CSV timezone confirmed by the user; fixed offset, no historical DST changes.
DATA_UTC_OFFSET_HOURS=5
TURBINE_1_LATITUDE=43.645150
TURBINE_1_LONGITUDE=78.535604
TURBINE_2_LATITUDE=43.643198
TURBINE_2_LONGITUDE=78.538828
# replay = reproducible 2026-02-01 forecast; live = current real weather.
FORECAST_MODE=replay
REPLAY_ORIGIN=2026-02-01T00:00:00+05:00
WEATHER_ALLOW_FALLBACK=true
WEATHER_OFFLINE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
